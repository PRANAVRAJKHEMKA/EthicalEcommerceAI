# FairCart AI Environment Configuration
# Optional: Set your Google Gemini API key to enable live AI copy generation.
# If left blank, FairCart AI automatically operates in resilient offline fallback mode.
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_PATH=faircart.db
DATABASE_URL=

# Merchant Administrative Protection Token (Optional)
ADMIN_TOKEN=

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of trusted frontend origins.
# In production, explicitly configure your trusted deployment domain(s).
# Note: Wildcard '*' must NOT be used with credentials (allow_credentials=True / HttpOnly session cookies).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
