# =============================================================================
# FairCart AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# Application Runtime Mode ('development' | 'production')
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration
# Local SQLite path (default: faircart.db in project root)
DATABASE_PATH=faircart.db
# PostgreSQL / Neon Connection String (Optional, e.g. postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require)
# When set, application automatically connects to PostgreSQL for durable persistence across restarts.
DATABASE_URL=

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of trusted frontend origins.
# In production, explicitly configure your trusted deployment domain(s) (e.g. https://your-storefront.onrender.com).
# Note: Wildcard '*' must NOT be used with credentials (allow_credentials=True / HttpOnly session cookies).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Merchant Administrative Protection Token (Optional)
# If set, POST /api/v1/settings requires header 'X-Admin-Token: <token>'
# Leave empty in local demo mode for open access.
ADMIN_TOKEN=

# Google Gemini API Key (Optional)
# Required for asynchronous natural-language customer-facing offer explanations.
# If omitted or unavailable, the built-in sub-5ms deterministic offline fallback is active.
GEMINI_API_KEY=
